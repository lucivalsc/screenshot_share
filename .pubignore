.flutter-plugins
.flutter-plugins-dependencies
*.log

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Internal docs and templates: useful in the repository, noise on pub.dev
/docs/
TEMPLATES.md
